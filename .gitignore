# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
# saved admin session for the e2e run
/tests/e2e/.auth/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
# e2e build output: its own directory so a `pnpm dev` you already have open and
# the Playwright server never share (and corrupt) one build.
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — only the example is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# print previews (pnpm print:preview)
/print/preview/
