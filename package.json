{
  "name": "autolink",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.ts",
    "print:preview": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/print-preview.ts",
    "check:codes": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-codes.ts",
    "admin:password": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/admin-password.ts",
    "reset:ratelimits": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/reset-rate-limits.ts"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.3",
    "argon2": "^0.45.1",
    "jszip": "^3.10.2",
    "mongoose": "^9.10.1",
    "nanoid": "^6.0.1",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core"
    ]
  }
}
