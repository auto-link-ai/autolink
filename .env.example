# Copy to .env (or .env.local) and fill in there. Never commit real values.
# No NEXT_PUBLIC_ variable may ever hold a secret or a database URI.

# --- Database (MongoDB Atlas) ---
# Put real values in .env or .env.local (both gitignored), never in this file.
MONGODB_URI=
MONGODB_DB_NAME=autolink

# --- Auth.js (owner sessions) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Web push (npx web-push generate-vapid-keys) ---
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@autolink.dz

# --- Email ---
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=AutoLink <notifications@autolink.dz>
ADMIN_ALERT_EMAIL=

# --- WhatsApp (Meta Cloud API) ---
# Owner alerts for scanner messages, as one approved template: {{1}} owner's
# name, {{2}} car, {{3}} kind of problem + what was written; URL button
# …/alert/{{1}}. Any of the first three empty: WhatsApp is off, push still works.
# Permanent token of a System User with whatsapp_business_messaging (the
# temporary one from API Setup expires after 24 hours).
WHATSAPP_ACCESS_TOKEN=
# "Phone number ID" in API Setup, not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ar
# Sign-in codes: an "Authentication" template with a Copy code button, same
# language, 10-minute expiry. Empty: outside production the code is printed in
# the server console; in production activation and PIN reset are unavailable.
WHATSAPP_CODE_TEMPLATE_NAME=
# Optional: car book reminders ({{1}} name, {{2}} car, {{3}} what is due; button
# …/alert/{{1}} with the sticker id). Empty: the alert template above is used.
WHATSAPP_REMINDER_TEMPLATE_NAME=
# Optional: Graph API version. Empty: v22.0.
WHATSAPP_API_VERSION=
# Optional: another address for the Cloud API (tests use a local stand-in). Empty: Meta.
WHATSAPP_API_BASE=

# --- Public ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Security ---
IP_HASH_SALT=
CRON_SECRET=
# Owners' PINs and WhatsApp codes are HMAC'd with this before hashing, so a
# database leak alone cannot reveal them. 32+ random characters, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it makes every PIN invalid (owners reset theirs by WhatsApp).
PIN_SECRET=

# --- Seed only (pnpm seed) ---
# Admin email defaults to ADMIN_ALERT_EMAIL. If SEED_ADMIN_PASSWORD is empty,
# a strong password is generated and printed once.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Message check (Google Gemini) ---
# Stops insults and threats, Darija included. Empty: messages are not checked.
GEMINI_API_KEY=
# Optional: another address for the Gemini API (tests use a local stand-in). Empty: Google.
GEMINI_API_BASE=
