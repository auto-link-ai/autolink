# Copy to .env.local and fill in. Never commit real values.
# No NEXT_PUBLIC_ variable may ever hold a secret or a database URI.

# --- Database (MongoDB Atlas) ---
MONGODB_URI=
MONGODB_DB_NAME=autotag

# --- Auth.js (owner sessions) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Web push (npx web-push generate-vapid-keys) ---
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@autotag.dz

# --- Email ---
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=AutoTag <notifications@autotag.dz>
ADMIN_ALERT_EMAIL=

# --- Public ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Security ---
IP_HASH_SALT=
CRON_SECRET=

# --- Seed only (pnpm seed) ---
# Admin email defaults to ADMIN_ALERT_EMAIL. If SEED_ADMIN_PASSWORD is empty,
# a strong password is generated and printed once.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
